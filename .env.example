# Copy to .env in the repo root. Secrets only — tunables belong in x2video.toml.
# Loader maps X2VIDEO_* onto config fields. Unprefixed TTS_* aliases also work.

# LLM (optional if you already ran `x2video auth login`)
# X2VIDEO_LLM_API_KEY=
# X2VIDEO_LLM_API_BASE_URL=https://api.x.ai/v1
# X2VIDEO_LLM_MODEL=grok-4-1-fast-reasoning

# Native X MCP (provider = "x_mcp"):
# X_BEARER_TOKEN=

# SuperGrok OAuth (provider = "grok"):
# Do NOT put OAuth tokens here. Run:
#   x2video auth login
# Credentials are stored in ~/.config/x2video/grok_auth.json

# TTS defaults (also configurable in x2video.toml)
TTS_PROVIDER=edge
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# Generic API-compatible TTS. Only used when TTS_PROVIDER=api.
# X2VIDEO_TTS_API_BASE_URL=
# X2VIDEO_TTS_API_KEY=
# TTS_API_MODEL=
# TTS_API_VOICE=
# TTS_API_FORMAT=mp3
# TTS_API_TIMEOUT_SECONDS=60
